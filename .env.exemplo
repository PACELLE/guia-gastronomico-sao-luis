# Copie este arquivo para .env e preencha com os seus valores.
# O .env NÃO vai para o GitHub. Aqui ficam só exemplos, sem valores reais.

# Porta do servidor
PORT=3000

# Conexão com o PostgreSQL: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgresql://usuario:senha@localhost:5432/guia_gastronomico

# Use true se o banco for online (Neon, Supabase, Render...); deixe false no PostgreSQL local
DATABASE_SSL=false

# Chave da sessão de login (S3): use um texto longo e aleatório
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio
